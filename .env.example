# =============================================================================
# El Arriero MCP — Configuración de entorno (Ejemplo)
# Copia este archivo como `.env` si deseas personalizar puertos o tiempos de
# espera locales. Todos los valores cuentan con respaldo estándar en el código.
# =============================================================================

# Endpoint IPC de Cisco Packet Tracer (PTMP)
PT_HOST=127.0.0.1
PT_PORT=39000

# Identificador ExApp registrado en Packet Tracer (pt-mcp-bridge.pta)
PT_APP_ID=dev.pktctl
PT_FALLBACK_APP_ID=net.netacad.cisco.pt.ipctest
PT_SHARED_KEY=cisco

# Servidor local Model Context Protocol (MCP Streamable HTTP)
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Tiempos límite de red y reconexión (segundos)
PT_CONNECT_TIMEOUT_S=5.0
PT_REQUEST_TIMEOUT_S=15.0
PT_MAX_RECONNECT_DELAY_S=30.0

